{
  "name": "nextjs-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typegen": "next typegen",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typegen && tsc --noEmit",
